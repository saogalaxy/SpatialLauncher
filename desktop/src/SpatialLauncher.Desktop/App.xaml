<Application x:Class="SpatialLauncher.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#FF1E1E24"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF2A2A32"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8ECF6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#99C4C9DA"/>
    <SolidColorBrush x:Key="ActiveGreen" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="ChipBrush" Color="#33FFFFFF"/>
    <Style TargetType="Button" x:Key="ChipButton">
      <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Button" x:Key="ChipButtonActive" BasedOn="{StaticResource ChipButton}">
      <Setter Property="Background" Value="{StaticResource ActiveGreen}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Resources>
</Application>
