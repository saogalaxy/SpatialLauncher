<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- No action bar: we draw our own title row in activity_panel_main.xml so it can't
         clip/overlap with the window body, unlike relying on a system ActionBar inset. -->
    <style name="Theme.SpatialLauncher.Panel" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/control_tint</item>
        <item name="colorPrimaryVariant">@color/panel_bg_solid</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/control_tint</item>
        <item name="colorAccent">@color/control_tint</item>
        <item name="colorControlActivated">@color/control_tint</item>
        <item name="colorPrimaryDark">@color/panel_bg_solid</item>
        <item name="android:windowBackground">@color/panel_bg_solid</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/panel_bg_solid</item>
        <item name="materialButtonStyle">@style/Widget.SpatialLauncher.SettingsButton</item>
    </style>

    <style name="Widget.SpatialLauncher.SettingsButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/dock_icon_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
