<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque dark panel so Help stays readable over the idle frosted UI. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/help_drawer_bg" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/help_drawer_border" />
</shape>
