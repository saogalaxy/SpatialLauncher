<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220">

    <!-- Isolated guest container (underneath). -->
    <FrameLayout
        android:id="@+id/sandbox_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="56dp" />

    <!-- Top 3D SBS overlay fed by MiDaS. -->
    <SurfaceView
        android:id="@+id/sandbox_stereo_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="56dp" />

    <View
        android:id="@+id/sandbox_touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="56dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/sandbox_branch_badge"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#E8166534"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#E80B1220"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/sandbox_capture_once"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/sandbox_capture_once" />

        <Button
            android:id="@+id/sandbox_close"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:text="@string/sandbox_close" />
    </LinearLayout>
</FrameLayout>
