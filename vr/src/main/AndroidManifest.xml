<?xml version="1.0" encoding="utf-8"?>
<!-- Merged ONLY into beta builds (:app references this module via
     betaImplementation). Release/debug manifests never see it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk">

    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="76" />

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="false" />
    <!-- Hand tracking suffices for this room (no controllers required):
         declares hands as capable input so the OS skips its controllers gate. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false" />

    <application>
        <activity
            android:name="com.spatiallauncher.vr.VrActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="vr" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
